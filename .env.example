# Server-only search key. Never prefix this with VITE_ — that would ship it to the browser.
# Use a SerpAPI key, or a Google Custom Search key plus GOOGLE_CSE_ID.
SEARCH_API_KEY=

# Required only when SEARCH_API_KEY is a Google Custom Search key
GOOGLE_CSE_ID=

# Optional public URL of the deployed Vercel proxy, e.g. https://your-app.vercel.app
# Leave empty to call same-origin /api/lookup (local Vite or the Vercel app itself).
VITE_LOOKUP_API_URL=
