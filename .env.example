# Server-only Gemini API key from Google AI Studio. Never prefix this with VITE_.
GEMINI_API_KEY=
SEARCH_API_KEY=

# Optional Gemini model override (defaults to gemini-2.5-flash)
GEMINI_MODEL=

# Optional public URL of the deployed Vercel proxy, e.g. https://your-app.vercel.app
# Leave empty to call same-origin /api/lookup (local Vite or the Vercel app itself).
VITE_LOOKUP_API_URL=
